  {
    "id": "chute-warn",
    "on": {
      "type": "use",
      "target": "chute-throat"
    },
    "once": true,
    "do": [
      {
        "kind": "print",
        "text": "You lean into the chute throat and understand two things at once: it goes all the way down, and nothing about you is ore. The polish on the timber is the testimony of everything that already went. Consider yourself warned, which is once more than the chute ever warns anybody."
      },
      {
        "kind": "setFlag",
        "flag": "chute-warned"
      }
    ]
