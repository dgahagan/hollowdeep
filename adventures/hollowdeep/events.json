[
  {
    "id": "office-door-opened",
    "on": {
      "type": "open",
      "target": "office-door"
    },
    "once": true,
    "do": [
      {
        "kind": "print",
        "text": "The door swings in on a room that has been holding its breath for ninety years. The hinges do not complain; somebody thorough oiled them before locking up for good."
      },
      {
        "kind": "setFlag",
        "flag": "office-door-open"
      }
    ]
  },
  {
    "id": "canary-on-credit",
    "on": {
      "type": "take",
      "target": "canary-cage"
    },
    "once": true,
    "if": [
      {
        "atLocation": "general-store"
      }
    ],
    "do": [
      {
        "kind": "print",
        "text": "The storekeeper does not stop you. \"On credit,\" he says, as though the terms were settled years ago and you are merely late. \"The bird knows the work. Settle up when you're rich.\""
      }
    ]
  },
