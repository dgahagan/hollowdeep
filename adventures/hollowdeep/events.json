[
  {
    "id": "office-door-opened",
    "on": {
      "type": "open",
      "target": "office-door"
    },
    "once": true,
    "do": [
      {
        "kind": "print",
        "text": "The door swings in on a room that has been holding its breath for ninety years. The hinges do not complain; somebody thorough oiled them before locking up for good."
      },
      {
        "kind": "setFlag",
        "flag": "office-door-open"
      }
    ]
  },
  {
    "id": "canary-on-credit",
    "on": {
      "type": "take",
      "target": "canary-cage"
    },
    "once": true,
    "if": [
      {
        "atLocation": "general-store"
      }
    ],
    "do": [
      {
        "kind": "print",
        "text": "The storekeeper does not stop you. \"On credit,\" he says, as though the terms were settled years ago and you are merely late. \"The bird knows the work. Settle up when you're rich.\""
      }
    ]
  },
  {
    "id": "magazine-door-opened",
    "on": {
      "type": "open",
      "target": "magazine-door"
    },
    "once": true,
    "do": [
      {
        "kind": "print",
        "text": "The iron door swings on hinges greased against exactly this long a wait. Inside, the dark smells of dry powder and good housekeeping."
      },
      {
        "kind": "setFlag",
        "flag": "magazine-door-open"
      }
    ]
  },
  {
    "id": "pump-fix",
    "on": {
      "type": "use",
      "target": "pump"
    },
    "once": true,
    "if": [
      {
        "hasItem": "pump-handle"
      }
    ],
    "do": [
      {
        "kind": "print",
        "text": "The handle drops into its socket with the click of two things resuming a long marriage. The pump is a pump again. It waits, with cast-iron patience, to be asked."
      },
      {
        "kind": "setFlag",
        "flag": "pump-fixed"
      }
    ]
  },
  {
    "id": "pump-drain",
    "on": {
      "type": "use",
      "target": "pump"
    },
    "once": true,
    "if": [
      {
        "flag": "pump-fixed"
      }
    ],
    "do": [
      {
        "kind": "print",
        "text": "You bear down. The pump takes hold — reluctant, then interested, then working — and throws black water into the drainage channel in long gouts. Somewhere below, the winze gives the water back with the stunned gurgle of an argument lost after ninety years of winning it."
      },
      {
        "kind": "setFlag",
        "flag": "pump-drained"
      }
    ]
  },
